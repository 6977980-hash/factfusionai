{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1120px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "bg", "name": "Background", "color": "#FFFFFF" },
				{ "slug": "text", "name": "Text", "color": "#111827" },
				{ "slug": "muted", "name": "Muted text", "color": "#4B5563" },
				{ "slug": "soft", "name": "Soft surface", "color": "#F3F4F6" },
				{ "slug": "border", "name": "Border", "color": "#E5E7EB" },
				{ "slug": "primary", "name": "Primary", "color": "#2563EB" },
				{ "slug": "primary-dark", "name": "Primary (hover)", "color": "#1D4ED8" },
				{ "slug": "on-primary", "name": "On primary", "color": "#FFFFFF" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": false },
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "1.75rem",
					"fluid": { "min": "1.375rem", "max": "1.75rem" }
				},
				{
					"slug": "xx-large",
					"name": "Huge",
					"size": "2.75rem",
					"fluid": { "min": "1.875rem", "max": "2.75rem" }
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "em", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "10", "name": "2XS", "size": "0.25rem" },
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "2rem" },
				{ "slug": "60", "name": "XL", "size": "clamp(2rem, 5vw, 3rem)" },
				{ "slug": "70", "name": "2XL", "size": "clamp(3rem, 8vw, 5rem)" }
			]
		},
		"shadow": {
			"defaultPresets": false
		},
		"custom": {
			"radius": {
				"default": "8px",
				"card": "12px",
				"pill": "9999px"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--bg)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"top": "0",
				"right": "var(--wp--preset--spacing--30)",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--30)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--primary-dark)" }
				}
			},
			"heading": {
				"typography": { "fontWeight": "700", "lineHeight": "1.25" }
			},
			"h1": {
				"typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" }
			},
			"h2": {
				"typography": { "fontSize": "var(--wp--preset--font-size--x-large)" }
			},
			"h3": {
				"typography": { "fontSize": "var(--wp--preset--font-size--large)" }
			},
			"h4": {
				"typography": { "fontSize": "var(--wp--preset--font-size--medium)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--on-primary)"
				},
				"border": { "radius": "var(--wp--custom--radius--default)", "width": "0" },
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600",
					"lineHeight": "1.25"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"right": "1.25rem",
						"bottom": "0.75rem",
						"left": "1.25rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-dark)",
						"text": "var(--wp--preset--color--on-primary)"
					}
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "700",
					"lineHeight": "1.25"
				},
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--text)" },
						"typography": { "textDecoration": "none" },
						":hover": {
							"color": { "text": "var(--wp--preset--color--text)" },
							"typography": { "textDecoration": "underline" }
						}
					}
				}
			},
			"core/site-tagline": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "500" },
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--text)" },
						"typography": { "textDecoration": "none" },
						":hover": {
							"color": { "text": "var(--wp--preset--color--text)" },
							"typography": { "textDecoration": "underline" }
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": {
							"typography": { "textDecoration": "underline" }
						}
					}
				}
			},
			"core/post-date": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/quote": {
				"border": {
					"left": { "color": "var(--wp--preset--color--primary)", "width": "4px", "style": "solid" }
				},
				"spacing": {
					"padding": { "left": "var(--wp--preset--spacing--40)" }
				}
			},
			"core/code": {
				"color": { "background": "var(--wp--preset--color--soft)" },
				"border": { "radius": "var(--wp--custom--radius--default)", "width": "0" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--30)",
						"right": "var(--wp--preset--spacing--30)",
						"bottom": "var(--wp--preset--spacing--30)",
						"left": "var(--wp--preset--spacing--30)"
					}
				}
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--border)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "breadcrumbs", "title": "Breadcrumbs", "area": "uncategorized" }
	],
	"customTemplates": [
		{ "name": "single-fact", "title": "Single Fact", "postTypes": [ "page" ] },
		{ "name": "facts", "title": "Browse Facts", "postTypes": [ "page" ] },
		{ "name": "embed", "title": "Embed (no header or footer)", "postTypes": [ "page" ] }
	]
}
